# Copy to .env (`make env`) and adjust. Never commit .env; no real secrets here.

# ===========================================
# Database (compose.yaml derives SPRING_DATASOURCE_* from these)
# ===========================================
POSTGRES_USER=thousand
# Placeholder only: set a strong, unique password in your local .env.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thousand_dev

# ===========================================
# Backend
# ===========================================
# compose.override.yaml sets SPRING_PROFILES_ACTIVE=dev for local development.
# SPRING_PROFILES_ACTIVE=dev

# ===========================================
# Optional: added by later backlog tasks
# ===========================================
# Password reset e-mail (SMTP)
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
