# NAIVE single-stage image - for size comparison only (Z1-02.01). Do not use.
# Everything (full Node toolchain, dev dependencies, sources, npm cache) ships in the
# final image, and the container runs as root.
FROM node:24
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build
EXPOSE 4173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
